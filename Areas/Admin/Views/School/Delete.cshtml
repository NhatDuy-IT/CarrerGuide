@model School
@{
    ViewData["Title"] = "Xóa trường học";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1 text-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>Xóa trường học
        </h2>
        <p class="text-muted">Bạn có chắc chắn muốn xóa trường học này?</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Quay lại
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="alert alert-danger" role="alert">
            <div class="d-flex">
                <div class="flex-shrink-0">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                </div>
                <div class="flex-grow-1 ms-3">
                    <h5 class="alert-heading">Cảnh báo!</h5>
                    <p class="mb-2">Hành động này sẽ <strong>xóa vĩnh viễn</strong> trường học khỏi hệ thống và không thể hoàn tác.</p>
                    <ul class="mb-0">
                        <li>Tất cả thông tin về trường sẽ bị mất</li>
                        <li>Trường sẽ không còn hiển thị trên website</li>
                        <li>Các liên kết đến trường này sẽ bị lỗi</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Thông tin trường sẽ bị xóa</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted small">Tên trường</label>
                        <div class="fw-bold">@Model.Name</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted small">Năm thành lập</label>
                        <div><span class="badge bg-info">@Model.EstablishedYear</span></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">Địa chỉ</label>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-geo-alt text-primary me-2"></i>
                        <span>@Model.Address</span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted small">Học phí</label>
                        <div class="fw-bold text-success">
                            @Model.TuitionFee.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                            <small class="text-muted">/ năm</small>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted small">Website</label>
                        <div>
                            @if (!string.IsNullOrEmpty(Model.Website))
                            {
                                <a href="@Model.Website" target="_blank" class="text-decoration-none">
                                    @Model.Website <i class="bi bi-box-arrow-up-right ms-1"></i>
                                </a>
                            }
                            else
                            {
                                <em class="text-muted">Chưa cập nhật</em>
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-3">
                        <label class="form-label text-muted small">Mô tả</label>
                        <div class="border rounded p-3 bg-light">
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
        
        <div class="mt-4">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Xác nhận xóa
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                        <i class="bi bi-eye me-2"></i>Xem chi tiết
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-2"></i>Hủy bỏ
                    </a>
                </div>
            </form>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light">
                <h6 class="mb-0">
                    <i class="bi bi-image me-2"></i>Hình ảnh
                </h6>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" 
                         class="img-fluid rounded" style="max-height: 200px; opacity: 0.7;">
                }
                else
                {
                    <div class="text-muted py-4">
                        <i class="bi bi-image display-4"></i>
                        <p class="mt-2">Không có hình ảnh</p>
                    </div>
                }
            </div>
        </div>
        
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="mb-0">
                    <i class="bi bi-shield-exclamation me-2"></i>Lưu ý quan trọng
                </h6>
            </div>
            <div class="card-body">
                <div class="alert alert-warning small mb-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Hành động này không thể hoàn tác
                </div>
                
                <div class="mb-3">
                    <h6 class="text-danger small">Trước khi xóa:</h6>
                    <ul class="list-unstyled small">
                        <li><i class="bi bi-check text-success me-2"></i>Đã sao lưu dữ liệu cần thiết</li>
                        <li><i class="bi bi-check text-success me-2"></i>Đã thông báo cho người dùng</li>
                        <li><i class="bi bi-check text-success me-2"></i>Đã kiểm tra các liên kết</li>
                    </ul>
                </div>
                
                <div class="text-center">
                    <small class="text-muted">ID: #@Model.Id</small>
                </div>
            </div>
        </div>
    </div>
</div>
