@model School
@{
    ViewData["Title"] = "Chi tiết trường học";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">
            <i class="bi bi-eye text-info me-2"></i>Chi tiết trường học
        </h2>
        <p class="text-muted">Thông tin chi tiết về trường: <strong>@Model.Name</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil me-2"></i>Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Thông tin chi tiết</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label class="form-label text-muted small">Tên trường</label>
                        <div class="fw-bold fs-5">@Model.Name</div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label class="form-label text-muted small">Năm thành lập</label>
                        <div class="fw-bold">
                            <span class="badge bg-info fs-6">@Model.EstablishedYear</span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">Mô tả</label>
                    <div class="border rounded p-3 bg-light">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <p class="mb-0">@Model.Description</p>
                        }
                        else
                        {
                            <em class="text-muted">Chưa có mô tả</em>
                        }
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-8 mb-4">
                        <label class="form-label text-muted small">Địa chỉ</label>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-geo-alt text-primary me-2"></i>
                            <span>@Model.Address</span>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <label class="form-label text-muted small">Số điện thoại</label>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-telephone text-success me-2"></i>
                            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                            {
                                <span>@Model.PhoneNumber</span>
                            }
                            else
                            {
                                <em class="text-muted">Chưa cập nhật</em>
                            }
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label class="form-label text-muted small">Website</label>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-globe text-info me-2"></i>
                            @if (!string.IsNullOrEmpty(Model.Website))
                            {
                                <a href="@Model.Website" target="_blank" class="text-decoration-none">
                                    @Model.Website <i class="bi bi-box-arrow-up-right ms-1"></i>
                                </a>
                            }
                            else
                            {
                                <em class="text-muted">Chưa cập nhật</em>
                            }
                        </div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label class="form-label text-muted small">Học phí</label>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-currency-dollar text-warning me-2"></i>
                            <span class="fw-bold text-success fs-5">
                                @Model.TuitionFee.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                            </span>
                            <small class="text-muted ms-2">/ năm</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light">
                <h6 class="mb-0">
                    <i class="bi bi-image me-2"></i>Hình ảnh trường học
                </h6>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" 
                         class="img-fluid rounded shadow-sm" style="max-height: 250px;">
                }
                else
                {
                    <div class="text-muted py-5">
                        <i class="bi bi-image display-1"></i>
                        <p class="mt-3">Chưa có hình ảnh</p>
                    </div>
                }
            </div>
        </div>
        
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>Thông tin hệ thống
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted">ID trường:</small>
                    <div class="fw-bold">#@Model.Id</div>
                </div>
                
                <div class="mb-3">
                    <small class="text-muted">Trạng thái:</small>
                    <div>
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                        </span>
                    </div>
                </div>
                
                <div class="mb-0">
                    <small class="text-muted">Hiển thị trên website:</small>
                    <div>
                        <span class="badge bg-primary">
                            <i class="bi bi-eye me-1"></i>Công khai
                        </span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="mb-0">
                    <i class="bi bi-gear me-2"></i>Thao tác
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil me-2"></i>Chỉnh sửa thông tin
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-2"></i>Xóa trường học
                    </a>
                    <hr>
                    <a asp-controller="School" asp-action="Details" asp-route-id="@Model.Id" 
                       class="btn btn-outline-primary" target="_blank">
                        <i class="bi bi-box-arrow-up-right me-2"></i>Xem trên website
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
