@model IEnumerable<School>
@{
    ViewData["Title"] = "Quản lý trường học";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">
            <i class="bi bi-building text-primary me-2"></i>Quản lý trường học
        </h2>
        <p class="text-muted">Quản lý thông tin các trường đại học trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Thêm trường mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <div class="row align-items-center">
            <div class="col">
                <h5 class="mb-0">Danh sách trường học</h5>
            </div>
            <div class="col-auto">
                <span class="badge bg-primary">@Model.Count() trường</span>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Hình ảnh</th>
                            <th>Tên trường</th>
                            <th>Địa chỉ</th>
                            <th>Học phí</th>
                            <th>Năm thành lập</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var school in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@school.ImageUrl" alt="@school.Name" 
                                         class="rounded" style="width: 60px; height: 40px; object-fit: cover;">
                                </td>
                                <td>
                                    <div>
                                        <strong>@school.Name</strong>
                                        @if (!string.IsNullOrEmpty(school.Website))
                                        {
                                            <br><small class="text-muted">
                                                <i class="bi bi-globe me-1"></i>
                                                <a href="@school.Website" target="_blank" class="text-decoration-none">
                                                    @school.Website
                                                </a>
                                            </small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>@school.Address
                                        @if (!string.IsNullOrEmpty(school.PhoneNumber))
                                        {
                                            <br><i class="bi bi-telephone me-1"></i>@school.PhoneNumber
                                        }
                                    </small>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">
                                        @school.TuitionFee.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                                    </span>
                                    <small class="text-muted d-block">/ năm</small>
                                </td>
                                <td>
                                    <span class="badge bg-info">@school.EstablishedYear</span>
                                </td>
                                <td>
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>Hoạt động
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@school.Id" 
                                           class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@school.Id" 
                                           class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@school.Id" 
                                           class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-building display-1 text-muted mb-3"></i>
                <h4 class="text-muted">Chưa có trường học nào</h4>
                <p class="text-muted">Hãy thêm trường học đầu tiên vào hệ thống</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Thêm trường mới
                </a>
            </div>
        }
    </div>
</div>

<style>
.table th {
    border-top: none;
    font-weight: 600;
    color: #495057;
}

.btn-group .btn {
    border-radius: 0.375rem !important;
    margin: 0 1px;
}

.table-hover tbody tr:hover {
    background-color: rgba(0, 123, 255, 0.05);
}
</style>
