@page
@model dynamic
@{
    ViewData["Title"] = "School Recommendations";
    Layout = "_Layout";
}

<!-- Hero Section with University Image -->
<div class="school-recommendations-hero">
    <img src="~/image/hutech.jpg" alt="HUTECH University" class="hero-image">
</div>

<!-- Recommendations Section -->
<section class="recommendations-section">
    <div class="container">
        <h1 class="recommendations-title">School Recommendations</h1>
        <p class="recommendations-text">Explore schools based on your performance and program strengths.<br>Find the best fit for your career goals.</p>
        <button class="btn-filters">
            <i class="fas fa-sliders-h"></i> Filters
        </button>
    </div>
</section>

<!-- School List Section -->
<section class="school-list">
    <div class="container">
        <!-- School Card 1 -->
        <div class="school-card position-relative">
            <div class="arrow-marker">
                <i class="fas fa-chevron-right"></i>
            </div>
            <img src="./image/HUTECH2.jpg" alt="HUTECH University" class="school-image">
            <div>
                <h3 class="school-name">ĐẠI HỌC CÔNG NGHỆ TPHCM</h3>
                <p class="school-type">PRIVATE SCHOOL</p>
            </div>
            <div class="school-score">95</div>
            <a href="https://www.hutech.edu.vn/" target="_blank" rel="noopener noreferrer">
                <button class="btn-see">SEE</button>
            </a>
        </div>

        <!-- School Card 2 -->
        <div class="school-card position-relative">
            <div class="arrow-marker">
                <i class="fas fa-chevron-right"></i>
            </div>
            <img src="./image/nhanvan.png" alt="University of Social Sciences and Humanities" class="school-image">
            <div>
                <h3 class="school-name">ĐẠI HỌC XÃ HỘI VÀ NHÂN VĂN</h3>
                <p class="school-type">PUBLIC SCHOOL</p>
            </div>
            <div class="school-score">96</div>
            <a href="https://hcmussh.edu.vn/" target="_blank" rel="noopener noreferrer">
                <button class="btn-see">SEE</button>
            </a>
        </div>

        <!-- School Card 3 -->
        <div class="school-card position-relative">
            <div class="arrow-marker">
                <i class="fas fa-chevron-right"></i>
            </div>
            <img src="./image/bachkhoa.jpg" alt="Hanoi University of Science and Technology" class="school-image">
            <div>
                <h3 class="school-name">ĐẠI HỌC BÁCH KHOA - HÀ NỘI</h3>
                <p class="school-type">PUBLIC SCHOOL</p>
            </div>
            <div class="school-score">99</div>
            <a href="https://hcmut.edu.vn/" target="_blank" rel="noopener noreferrer">
                <button class="btn-see">SEE</button>
            </a>
        </div>

        <button class="btn-more">MORE...</button>
    </div>
</section>

<!-- Top Schools Section -->
<section class="top-schools-section">
    <div class="container">
        <h2 class="top-schools-title">TOP 5 TRƯỜNG ĐẠI HỌC Ở VIỆT NAM</h2>
        
        <div class="school-ranking-table">
            <!-- School Ranking 1 -->
            <div class="school-ranking-row">
                <div class="school-ranking-name">Đại học Quốc gia TP. Hồ Chí Minh</div>
                <div class="school-ranking-score">95,00</div>
            </div>
            
            <!-- School Ranking 2 -->
            <div class="school-ranking-row">
                <div class="school-ranking-name">Trường Đại học Tôn Đức Thắng</div>
                <div class="school-ranking-score">89,80</div>
            </div>
            
            <!-- School Ranking 3 -->
            <div class="school-ranking-row">
                <div class="school-ranking-name">Đại học Bách khoa Hà Nội</div>
                <div class="school-ranking-score">86,90</div>
            </div>
            
            <!-- School Ranking 4 -->
            <div class="school-ranking-row">
                <div class="school-ranking-name">Đại học Duy Tân</div>
                <div class="school-ranking-score">85,00</div>
            </div>
            
            <!-- School Ranking 5 -->
            <div class="school-ranking-row">
                <div class="school-ranking-name">Trường Đại học Kinh tế TP. Hồ Chí Minh</div>
                <div class="school-ranking-score">83,50</div>
            </div>
        </div>
    </div>
</section>