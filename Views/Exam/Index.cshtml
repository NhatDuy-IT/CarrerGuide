@model List<Exam>
@{
    ViewData["Title"] = "Danh sách bài kiểm tra";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="fw-bold">Danh sách bài kiểm tra</h1>
        <p class="text-muted">Thử thách bản thân với các bài kiểm tra đa dạng</p>
    </div>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var exam in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">@exam.Title</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="card-text">@exam.Description</p>
                        
                        <div class="exam-info mb-3">
                            <div class="row text-center">
                                <div class="col-4">
                                    <div class="border-end">
                                        <h6 class="text-primary">@exam.TotalQuestions</h6>
                                        <small class="text-muted">Câu hỏi</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border-end">
                                        <h6 class="text-success">@exam.Duration</h6>
                                        <small class="text-muted">Phút</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <h6 class="text-info">@exam.CreatedDate.ToString("dd/MM")</h6>
                                    <small class="text-muted">Ngày tạo</small>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-auto">
                            <div class="d-grid gap-2">
                                <a asp-action="Take" asp-route-id="@exam.Id" class="btn btn-primary">
                                    <i class="bi bi-play-circle"></i> Bắt đầu làm bài
                                </a>
                                <a asp-action="Details" asp-route-id="@exam.Id" class="btn btn-outline-secondary">
                                    <i class="bi bi-info-circle"></i> Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Hiện tại chưa có bài kiểm tra nào.
            </div>
        </div>
    }
</div>

@if (User.Identity.IsAuthenticated)
{
    <div class="row mt-4">
        <div class="col-12 text-center">
            <a asp-action="MyResults" class="btn btn-success">
                <i class="bi bi-clipboard-data"></i> Xem kết quả của tôi
            </a>
        </div>
    </div>
}
else
{
    <div class="row mt-4">
        <div class="col-12">
            <div class="alert alert-warning text-center">
                <i class="bi bi-exclamation-triangle"></i> 
                Bạn cần <a asp-controller="Account" asp-action="Login" class="alert-link">đăng nhập</a> 
                để lưu kết quả bài kiểm tra.
            </div>
        </div>
    </div>
}
