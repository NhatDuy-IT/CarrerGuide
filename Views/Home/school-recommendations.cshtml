@{
    ViewData["Title"] = "School Recommendations";
    Layout = "_Layout";
}
<!-- Hero Section with University Image -->
<div class="school-recommendations-hero">
    <img src="~/image/hutech.jpg" alt="HUTECH University" class="hero-image">
</div>
<!-- Recommendations Section -->
<section class="recommendations-section">
    <div class="container">
        <h1 class="recommendations-title">School Recommendations</h1>
        <p class="recommendations-text">Explore schools based on your performance and program strengths.<br>Find the best fit for your career goals.</p>
        <button class="btn-filters">
            <i class="fas fa-sliders-h"></i> Filters
        </button>
    </div>
</section>
